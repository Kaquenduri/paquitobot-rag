        {
            "assignment_id": 1771852,
            "name": "Presentación Visual Final Mkt",
            "description": "<link rel=\"stylesheet\" href=\"https://instructure-uploads.s3.amazonaws.com/account_81840000000000001/attachments/139077/tecsup.instructure.css\"><h2><span style=\"font-size: 12pt;\">La presentación visual final puede ser en PPT o Canva, debe incluir:</span></h2>\n<ul>\n<li><span style=\"font-size: 12pt;\">Nombre y Logo de la marca</span></li>\n<li><span style=\"font-size: 12pt;\">Slogan</span></li>\n<li>\n<span style=\"font-size: 12pt;\">Misión, </span><span style=\"font-size: 12pt;\">Visión y </span><span style=\"font-size: 12pt;\">Valores</span>\n</li>\n<li><span style=\"font-size: 12pt;\">Descripción del producto o servicio.</span></li>\n<li><span style=\"font-size: 12pt;\">Definición de propuesta de valor.</span></li>\n<li><span style=\"font-size: 12pt;\">Canales de distribución (físicos y digitales).</span></li>\n<li><span style=\"font-size: 12pt;\">Justificación del precio elegido.</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">Encuesta (Un slide por pregunta - 10 a 12)</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Pregunta y Gráfico estadístico (diagrama de pastel, gráfico de barras, gráfico lineal).</span></li>\n<li><span style=\"font-size: 12pt;\">Resumen de principales hallazgos.</span></li>\n</ul>\n<p><span style=\"font-size: 12pt;\"><strong>Entrevistas (Un slide por entrevista - 3)</strong></span></p>\n<ul>\n<li><span style=\"font-size: 12pt;\">Foto del entrevistado, nombre, edad, ocupación.</span></li>\n<li><span style=\"font-size: 12pt;\">Insights positivos y negativos.</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">Focus Group (Un slide)</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Foto del focus</span></li>\n<li><span style=\"font-size: 12pt;\">Insights positivos y negativos.</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">Marketing Digital</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Estrategias digitales (inbound/outbound).</span></li>\n<li><span style=\"font-size: 12pt;\">Plataformas digitales a utilizar: Página web, app, ecommerce, etc.</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">SEO&nbsp;</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Estrategia básica de posicionamiento orgánico (SEO).</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">Redes Sociales</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Objetivos SMART</span></li>\n<li><span style=\"font-size: 12pt;\">Redes Sociales.</span></li>\n<li><span style=\"font-size: 12pt;\">Marketing de Contenidos.</span></li>\n<li><span style=\"font-size: 12pt;\">Storytelling.</span></li>\n<li><span style=\"font-size: 12pt;\">Parrilla de contenidos de una semana.</span></li>\n</ul>\n<h3><strong><span style=\"font-size: 12pt;\">Aliados Estratégicos</span></strong></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Identificación de socios clave, influencers o aliados comerciales.</span></li>\n</ul>\n<p><span style=\"font-size: 12pt;\"><strong>Conclusiones </strong></span></p>\n<p><span style=\"font-size: 12pt;\"><strong>Recomendaciones</strong></span></p>\n<p><span style=\"font-size: 12pt;\">Traer el producto o prototipo final, merch, etc.</span></p>\n<p><span style=\"font-size: 12pt;\"><strong>Tiempo de exposición:</strong> 20 minutos</span></p>\n<p><span style=\"font-size: 12pt;\"><strong>&nbsp;</strong></span></p><script src=\"https://instructure-uploads.s3.amazonaws.com/account_81840000000000001/attachments/139278/js-logo.js\"></script>",
