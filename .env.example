# Plantilla de configuracion. Copiala a .env y rellena los valores.
#
#   copy .env.example .env
#
# .env esta en .gitignore y NUNCA debe subirse: lleva la llave con la que
# se cifran los tokens de Canvas de los alumnos.

# --- Base de datos -----------------------------------------------------
# Puerto 5433 a proposito: no choca con un Postgres local en el 5432.
# Debe usar un driver asincrono (postgresql+psycopg:// o +asyncpg://);
# Settings rechaza cualquier otro esquema al arrancar.
SUPABASE_DATABASE_URL=postgresql+psycopg://paquito:paquito@127.0.0.1:5433/paquito

# --- Secretos ----------------------------------------------------------
# Genera los tuyos, no copies los de otro:
#
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; import secrets; print('TENANT_TOKEN_KEY=' + Fernet.generate_key().decode()); print('BACKEND_SECRET=' + secrets.token_urlsafe(48))"
#
# TENANT_TOKEN_KEY cifra los tokens de Canvas en la base (Fernet, tiene
# que decodificar a exactamente 32 bytes). BACKEND_SECRET firma los JWT.
TENANT_TOKEN_KEY=
BACKEND_SECRET=

# --- Canvas ------------------------------------------------------------
CANVAS_API_BASE_URL=https://tecsup.instructure.com/api/v1

# --- Modelo de chat ----------------------------------------------------
# Cualquier proveedor compatible con OpenAI. Cambiar de local a una API
# de pago es cambiar estas tres lineas, sin tocar codigo:
#
#   Ollama local (gratis, lento):
#     LLM_BASE_URL=http://127.0.0.1:11434/v1
#     LLM_MODEL=qwen2.5:3b
#     LLM_API_KEY=ollama
#
#   API (rapido, centavos por consulta):
#     LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-chat
#     LLM_API_KEY=<tu key>
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=300

# --- Ollama (embeddings; la busqueda vectorial aun no esta activa) ------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_EMBED_DIM=1024

# --- Local -------------------------------------------------------------
LOG_LEVEL=INFO

# El scheduler sincroniza Canvas cada 6 horas por su cuenta. En local
# estorba: sincroniza tu a mano con POST /sync.
SCHEDULER_ENABLED=false

# PELIGRO: DEV_UI_ENABLED monta /dev, que entrega sesiones de alumno SIN
# pedir contrasena. Es andamio para probar en tu maquina. Jamas en un
# despliegue real.
DEV_UI_ENABLED=false
